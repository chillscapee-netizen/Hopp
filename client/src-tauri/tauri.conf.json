{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hopp",
  "version": "0.3.14",
  "identifier": "se.strom.client",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Hopp",
        "create": false,
        "width": 480,
        "height": 600,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "visible": false,
        "decorations": false,
        "backgroundColor": "#2c2c31",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https://i.ytimg.com https://hopp-cloud.hoppchat.workers.dev http://127.0.0.1:8787 https://static.klipy.com https://static1.klipy.com https://static2.klipy.com https://static3.klipy.com; style-src 'self' 'unsafe-inline'; frame-src https://www.youtube-nocookie.com; connect-src 'self' ipc: http://ipc.localhost https://hopp-cloud.hoppchat.workers.dev http://127.0.0.1:8787"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Hopp",
    "copyright": "Â© 2026 Hopp",
    "category": "SocialNetworking",
    "shortDescription": "Voice and chat for you and your friends",
    "longDescription": "Hopp is voice and chat for friends: clear low-latency voice, servers with text and voice channels, and private end-to-end encrypted DMs. Free, no ads, light on your computer.",
    "homepage": "https://hopp-cloud.hoppchat.workers.dev/",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "compression": "lzma",
        "installerHooks": "installer/hooks.nsh"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "hopp",
          "strom"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERCMzA0RTAyNURBMzcyQkYKUldTL2NxTmRBazR3MjExeVpyMnc0U1hhaTVlajlDaVR6cGdBeXArdURKK2p1N3F2TlFqVzBWTzIK",
      "endpoints": [
        "https://hopp-cloud.hoppchat.workers.dev/update/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
