{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hopp",
  "version": "0.2.0",
  "identifier": "se.strom.client",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Hopp",
        "width": 480,
        "height": 600,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "visible": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://static.klipy.com https://static1.klipy.com https://static2.klipy.com https://static3.klipy.com; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "hopp",
          "strom"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERCMzA0RTAyNURBMzcyQkYKUldTL2NxTmRBazR3MjExeVpyMnc0U1hhaTVlajlDaVR6cGdBeXArdURKK2p1N3F2TlFqVzBWTzIK",
      "endpoints": [
        "https://hopp.hoppchat.workers.dev/update/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
