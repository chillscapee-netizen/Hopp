{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hopp",
  "version": "0.1.0",
  "identifier": "se.strom.client",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Hopp",
        "width": 1280,
        "height": 800,
        "minWidth": 940,
        "minHeight": 560,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "hopp",
          "strom"
        ]
      }
    }
  }
}
