LangString addOrReinstall ${LANG_ENGLISH} "Repair Hopp (install it again)"
LangString alreadyInstalled ${LANG_ENGLISH} "Hopp is already here"
LangString alreadyInstalledLong ${LANG_ENGLISH} "${PRODUCTNAME} ${VERSION} is already installed. You can install it again, which repairs it, or remove it. Your account, friends and settings stay either way unless you choose to delete them."
LangString appRunning ${LANG_ENGLISH} "Hopp is running. Quit it first (right-click its icon by the clock and choose Quit), then try again."
LangString appRunningOkKill ${LANG_ENGLISH} "Hopp is running.$\nClick OK to close it and continue."
LangString chooseMaintenanceOption ${LANG_ENGLISH} "Choose what you'd like to do."
LangString chooseHowToInstall ${LANG_ENGLISH} "Hopp will be updated to version ${VERSION}."
LangString createDesktop ${LANG_ENGLISH} "Put Hopp on the desktop"
LangString dontUninstall ${LANG_ENGLISH} "Install over the old version as it is"
LangString dontUninstallDowngrade ${LANG_ENGLISH} "Install over the newer version (not possible: going back to an older version needs the newer one removed first)"
LangString failedToKillApp ${LANG_ENGLISH} "Hopp couldn't be closed. Quit it first (right-click its icon by the clock and choose Quit), then try again."
LangString installingWebview2 ${LANG_ENGLISH} "Installing WebView2, which Hopp uses to show its window..."
LangString newerVersionInstalled ${LANG_ENGLISH} "A newer version of ${PRODUCTNAME} is already installed. Installing this older one isn't recommended. If you still want to, remove the newer version first; your account, friends and settings stay."
LangString older ${LANG_ENGLISH} "older"
LangString olderOrUnknownVersionInstalled ${LANG_ENGLISH} "An $R4 version of ${PRODUCTNAME} is installed. It will be replaced with this one. Your account, friends, messages and settings stay just as they are."
LangString silentDowngrades ${LANG_ENGLISH} "Going back to an older version can't be done silently. Run the installer normally instead.$\n"
LangString unableToUninstall ${LANG_ENGLISH} "The old version couldn't be removed."
LangString uninstallApp ${LANG_ENGLISH} "Remove Hopp"
LangString uninstallBeforeInstalling ${LANG_ENGLISH} "Replace the old version (recommended)"
LangString unknown ${LANG_ENGLISH} "earlier"
LangString webview2AbortError ${LANG_ENGLISH} "WebView2 couldn't be installed, and Hopp can't run without it. Try running the installer again."
LangString webview2DownloadError ${LANG_ENGLISH} "Error: WebView2 couldn't be downloaded - $0"
LangString webview2DownloadSuccess ${LANG_ENGLISH} "WebView2 downloaded"
LangString webview2Downloading ${LANG_ENGLISH} "Downloading WebView2..."
LangString webview2InstallError ${LANG_ENGLISH} "Error: WebView2 couldn't be installed (code $1)"
LangString webview2InstallSuccess ${LANG_ENGLISH} "WebView2 installed"
LangString deleteAppData ${LANG_ENGLISH} "Also delete my Hopp data on this computer (account, settings, logs)"
