{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "strom-cloud",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Every Ström server is one Durable Object with its own SQLite database, and
  // one more object keeps the global register of short invite codes.
  // Only SQLite-backed Durable Objects are available on the Workers Free plan.
  "durable_objects": {
    "bindings": [
      { "name": "SERVERS", "class_name": "StromServer" },
      { "name": "INVITES", "class_name": "InviteIndex" },
      { "name": "ACCOUNTS", "class_name": "StromAccount" },
      { "name": "DIRECTORY", "class_name": "UserDirectory" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["StromServer"] },
    { "tag": "v2", "new_sqlite_classes": ["InviteIndex"] },
    { "tag": "v3", "new_sqlite_classes": ["StromAccount", "UserDirectory"] }
  ],
  // The Windows installer (copied in by `npm run deploy`), served at /download/Hopp-setup.exe.
  "assets": { "directory": "./public" },
  "observability": { "enabled": true }
}
